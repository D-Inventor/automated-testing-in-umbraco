eters\": [\r\n          {\r\n            \"name\": \"target\",\r\n            \"in\": \"query\",\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"before\",\r\n            \"in\": \"query\",\r\n            \"schema\": {\r\n              \"type\": \"integer\",\r\n              \"format\": \"int32\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"after\",\r\n            \"in\": \"query\",\r\n            \"schema\": {\r\n              \"type\": \"integer\",\r\n              \"format\": \"int32\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"foldersOnly\",\r\n            \"in\": \"query\",\r\n            \"schema\": {\r\n              \"type\": \"boolean\",\r\n              \"default\": false\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/SubsetMemberTypeTreeItemResponseModel\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"The resource is protected and requires an authentication token\"\r\n          },\r\n          \"403\": {\r\n            \"description\": \"The authenticated user does not have access to this resource\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"Backoffice-User\": []\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/umbraco/management/api/v1/models-builder/build\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Models Builder\"\r\n        ],\r\n        \"summary\": \"Builds models.\",\r\n        \"description\": \"Triggers the models builder to generate strongly-typed models