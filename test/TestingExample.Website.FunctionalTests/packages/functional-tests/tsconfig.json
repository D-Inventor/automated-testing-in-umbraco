{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "paths": {
      "@scenario/*": [
        "./scenario/*"
      ]
    }
  },
  "include": [
    "scenario/**/*",
    "tests/**/*"
  ],
}